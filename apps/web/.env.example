# ==============================================================================
# @kg/web – Környezeti változók minta (.env.example)
# Másold le .env.local néven a lokális fejlesztéshez!
# Értéket (titkot) soha ne commitolj a repóba.
# ==============================================================================

# --- Adatforrás mód ---
# 1: Woo helyett a mentett Store API-fixture-ök (CI e2e, Docker nélküli fejlesztés).
# 0: Valódi WooCommerce példány hívása (alapértelmezett).
KG_STORE_FIXTURES=0

# --- Publikus (kliensre is kerülő) változók ---
# Környezet jelölése: local | preview | demo | production
# Preview és demo környezetben automatikus X-Robots-Tag: noindex, nofollow fejlécet kapcsol be.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SENTRY_DSN=

# --- 1. Brand: Gamer (szerveroldali, BFF) ---
# Lokális Docker-Woo (KG-4): http://localhost:8080
WOO_GAMER_URL=
# REST v3 hitelesítő adatok (csak szerveroldalon, NEXT_PUBLIC_ soha!)
WOO_GAMER_CONSUMER_KEY=
WOO_GAMER_CONSUMER_SECRET=
# WooCommerce webhook HMAC-SHA256 aláírás-ellenőrző titok
WOO_GAMER_WEBHOOK_SECRET=
