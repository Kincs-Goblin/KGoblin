# --- Trigger.dev ---
# Kötelező: Projekt azonosító (formátum: proj_<azonosító>) és titkos kulcs (tr_dev_... / tr_prod_...)
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# --- Hibakövetés (Sentry) ---
SENTRY_DSN=

# --- 1. Brand: Gamer (WooCommerce REST v3 & Webhook) ---
WOO_GAMER_URL=
WOO_GAMER_CONSUMER_KEY=
WOO_GAMER_CONSUMER_SECRET=
WOO_GAMER_WEBHOOK_SECRET=
