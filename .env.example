# ==============================================================================
# KGoblin – Lokális fejlesztői környezet minta (.env.example)
# Másold le .env néven, ha egyedi portot vagy jelszót szeretnél!
# A docker-compose.yml alapértelmezett lokális értékekkel .env nélkül is elindul.
# ==============================================================================

# --- Adatbázis (MariaDB 10.11) ---
WP_DB_ROOT_PASSWORD=kg_local_root_secret
WP_DB_USER=kg_wp_user
WP_DB_PASSWORD=kg_wp_local_pass

# --- 1. Brand: Gamer ---
WP_GAMER_PORT=8080
WP_GAMER_DB_NAME=wp_gamer
WP_GAMER_TITLE="KincsGoblin Gamer Backend"
WP_GAMER_ADMIN_USER=admin
WP_GAMER_ADMIN_PASSWORD=admin123
WP_GAMER_ADMIN_EMAIL=admin@kincsgoblin.local
WP_GAMER_FRONTEND_URL=http://localhost:3000

# --- 2. Brand példa (második Woo példány indításához, külön DB userrel) ---
# WP_BRAND2_PORT=8081
# WP_BRAND2_DB_NAME=wp_brand2
# WP_BRAND2_DB_USER=kg_wp_brand2_user
# WP_BRAND2_DB_PASSWORD=kg_wp_local_pass
# WP_BRAND2_TITLE="KincsGoblin Második Brand Backend"
# WP_BRAND2_FRONTEND_URL=http://localhost:3001
